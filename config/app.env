# Shared non-secret runtime defaults.
# Local secrets and personal overrides belong in .env.

OPENAI_MODEL=gpt-5.6-terra
REPORT_AGENT_PROVIDER=openai
REPORT_AGENT_ALLOWED_MODELS=gpt-5.4,gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
REPORT_AGENT_TITLE_MODEL=gpt-5.6-luna
REPORT_AGENT_EXECUTION_OUTPUT_SATISFACTION_REVIEW=0
REPORT_AGENT_ATTACHMENT_MAX_BYTES=52428800
REPORT_AGENT_ATTACHMENT_MAX_FILES_PER_MESSAGE=10
REPORT_AGENT_ATTACHMENT_MAX_MESSAGE_BYTES=209715200
REPORT_AGENT_ATTACHMENT_MAX_DOCUMENT_PAGES=200
REPORT_AGENT_ATTACHMENT_MAX_EXTRACTED_CHARS=200000
REPORT_AGENT_ATTACHMENT_MAX_IMAGE_PIXELS=50000000
REPORT_AGENT_ATTACHMENT_STAGED_TTL_SECONDS=86400
REPORT_AGENT_ATTACHMENT_MAX_TABLE_ROWS=100000
REPORT_AGENT_ATTACHMENT_MAX_TABLE_COLUMNS=1000
REPORT_AGENT_ATTACHMENT_MAX_TABLE_CELLS=1000000
DB_RAG_EMBEDDING_MODEL=OpenAI/text-embedding-3-large
DB_RAG_RERANKER_MODEL=
DB_RAG_DATASET_NAMING_MODEL=gpt-5.6-luna
